{
  "schema_version": 3,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "推送被拒之后：一条可恢复的路径",
    "subtitle": "non-fast-forward 不是终点，先 fetch 再把你的提交重放到新基点上",
    "locale": "zh-CN",
    "output": "Git/assets/push-rescue.html",
    "quality_profile": "showcase"
  },
  "mainPath": ["local", "push", "rejected", "fetch", "rebase", "pushed"],
  "states": [
    {
      "id": "local",
      "type": "start",
      "label": "本地提交 D",
      "sublabel": "基于 B，远程已有 C",
      "tag": "你的仓库",
      "step": "01"
    },
    {
      "id": "push",
      "type": "decision",
      "label": "git push",
      "sublabel": "远程检查祖先关系",
      "tag": "请求",
      "step": "02"
    },
    {
      "id": "rejected",
      "type": "failure",
      "label": "推送被拒",
      "sublabel": "远程历史里没有 D",
      "tag": "non-fast-forward",
      "step": "03"
    },
    {
      "id": "fetch",
      "type": "active",
      "label": "git fetch",
      "sublabel": "下载 C，刷新 origin/main",
      "tag": "安全",
      "step": "04"
    },
    {
      "id": "rebase",
      "type": "decision",
      "label": "git pull --rebase",
      "sublabel": "把 D 重放到 C 之后",
      "tag": "重写本地历史",
      "step": "05"
    },
    {
      "id": "pushed",
      "type": "success",
      "label": "推送成功",
      "sublabel": "D' 接在 C 之后",
      "tag": "fast-forward",
      "step": "06"
    },
    {
      "id": "conflict",
      "type": "waiting",
      "label": "rebase 冲突",
      "sublabel": "同一处被两边修改",
      "tag": "需手工解决"
    },
    {
      "id": "force",
      "type": "failure",
      "label": "git push --force",
      "sublabel": "远程 C 被抹掉",
      "tag": "危险"
    }
  ],
  "transitions": [
    { "id": "local-push", "from": "local", "to": "push", "label": "执行" },
    { "id": "push-rejected", "from": "push", "to": "rejected", "label": "拒绝" },
    { "id": "rejected-fetch", "from": "rejected", "to": "fetch", "label": "取回 C", "variant": "emphasis" },
    { "id": "fetch-rebase", "from": "fetch", "to": "rebase", "label": "重放" },
    { "id": "rebase-pushed", "from": "rebase", "to": "pushed", "label": "推送", "variant": "emphasis" },
    { "id": "rebase-conflict", "from": "rebase", "to": "conflict", "label": "同一处冲突", "variant": "dashed" },
    { "id": "conflict-pushed", "from": "conflict", "to": "pushed", "label": "解决后 --continue" },
    { "id": "rejected-force", "from": "rejected", "to": "force", "label": "图省事", "variant": "security" }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "为什么会被拒",
      "items": [
        "远程有 C，你的历史里没有 C；接受 D 会让 C 变成不可达提交",
        "Git 的铁律：push 只允许快进（fast-forward）",
        "拒绝是在保护别人已经推上去的工作，不是你的账号有问题"
      ]
    },
    {
      "dot": "emerald",
      "title": "rebase 之后为什么能推",
      "items": [
        "rebase 把 D 的改动重放到 C 之后，得到 D'",
        "此时 C 是 D' 的祖先，push 变成快进",
        "代价：D 的哈希变成了 D'；已经共享的提交不要 rebase"
      ]
    },
    {
      "dot": "amber",
      "title": "force-with-lease 的边界",
      "items": [
        "只用于你自己的分支，或确认只有你在用的分支",
        "它要求远程位置与你上次 fetch 时一致，比你直接 --force 多一道保险",
        "共享分支上永远不要 --force：那会抹掉同事刚推的提交"
      ]
    }
  ]
}
